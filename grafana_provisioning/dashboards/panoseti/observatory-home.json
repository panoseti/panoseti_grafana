  "panels": [
    {
      "datasource": {
        "type": "influxdb",
        "uid": "P697866FB46CDC82E"
      },
      "description": "Last AGG_STATUS_MSG report from each Quabo.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "mappings": [
            {
              "options": {
                "0": {
                  "color": "green",
                  "index": 6,
                  "text": "ok"
                },
                "8": {
                  "color": "blue",
                  "index": 5,
                  "text": "info"
                },
                "16": {
                  "color": "orange",
                  "index": 4,
                  "text": "warn"
                },
                "32": {
                  "color": "red",
                  "index": 3,
                  "text": "crit"
                }
              },
              "type": "value"
            },
            {
              "options": {
                "pattern": "/.*:critical:.*/",
                "result": {
                  "color": "red",
                  "index": 0
                }
              },
              "type": "regex"
            },
            {
              "options": {
                "pattern": "/.*:warn:.*/",
                "result": {
                  "color": "orange",
                  "index": 1
                }
              },
              "type": "regex"
            },
            {
              "options": {
                "pattern": "/.*:ok:.*/",
                "result": {
                  "color": "green",
                  "index": 2
                }
              },
              "type": "regex"
            }
          ],
          "noValue": "No data",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "transparent",
                "value": 0
              },
              {
                "color": "red",
                "value": 80
              }
            ]
          },
          "unit": "none"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Value"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "More details",
                    "url": "/d/oVK2NBrnk/examine-specific-quabo?${__url_time_range}&var-quabo=${__series.name}&var-observatory=${observatory}"
                  }
                ]
              }
            ]
          }
        ]
      },
      "gridPos": {
        "h": 18,
        "w": 9,
        "x": 0,
        "y": 0
      },
      "id": 10,
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "center",
        "orientation": "auto",
        "percentChangeColorMode": "standard",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "/.*/",
          "values": false
        },
        "showPercentChange": false,
        "text": {},
        "textMode": "name",
        "wideLayout": true
      },
      "pluginVersion": "12.3.1",
      "targets": [
        {
          "alias": "$measurement",
          "datasource": {
            "type": "influxdb",
            "uid": "P697866FB46CDC82E"
          },
          "groupBy": [
            {
              "params": [
                "$__interval"
              ],
              "type": "time"
            },
            {
              "params": [
                "null"
              ],
              "type": "fill"
            }
          ],
          "orderByTime": "ASC",
          "policy": "default",
          "query": "SELECT last(\"AGG_STATUS_LEVEL\")\nFROM /QUABO_.*/\nWHERE \"observatory\" = '$observatory' AND \"datatype\"='housekeeping' AND $timeFilter\nGROUP BY time($__interval), \"UID\" fill(null)",
          "rawQuery": true,
          "refId": "A",
          "resultFormat": "time_series",
          "select": [
            [
              {
                "params": [
                  "value"
                ],
                "type": "field"
              },
              {
                "params": [],
                "type": "mean"
              }
            ]
          ],
          "tags": []
        }
      ],
      "title": "Overall Quabo Status",
      "transformations": [
        {
          "id": "filterFieldsByName",
          "options": {
            "include": {
              "pattern": "/QUABO_?.*/"
            }
          }
        },
        {
          "id": "renameByRegex",
          "options": {
            "regex": "QUABO_?(.*)",
            "renamePattern": "Q$1"
          }
        }
      ],
      "type": "stat"
    },
